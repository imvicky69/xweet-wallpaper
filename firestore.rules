rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Wallpapers Collection:
    // Anyone can read and stream wallpapers on mobile & web.
    // Writes are restricted to Admin SDK / Service Account.
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow write: if false;
    }

    // Authors Collection (if present)
    match /authors/{authorId} {
      allow read: if true;
      allow write: if false;
    }

    // Collections taxonomy (if present)
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
