# =======================================================
# XWEET WALLPAPERS — ENVIRONMENT CONFIGURATION
# =======================================================

# -------------------------------------------------------
# 1. FIREBASE AUTH & FIRESTORE (Client & Server)
# -------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="xweet-wallpaper.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="xweet-wallpaper"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="xweet-wallpaper.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# -------------------------------------------------------
# 2. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# -------------------------------------------------------
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="xweet-wallpapers"

# Public CDN domain connected to your R2 bucket (e.g., https://cdn.xweet.com or pub-xxx.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_DOMAIN="https://cdn.xweet.com"

# -------------------------------------------------------
# 3. FIREBASE ADMIN SERVICE ACCOUNT (For Initial Push / Migration)
# -------------------------------------------------------
# Either path to serviceAccountKey.json or individual keys
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@xweet-wallpaper.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"
